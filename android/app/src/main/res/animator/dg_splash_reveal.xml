<?xml version="1.0" encoding="utf-8"?>
<!-- The circle that uncovers the gem from its centre: closed for 250 ms (the splash window is often not on screen yet), then open in 384 ms. The hold is an animator of its own that keeps the start shape, not a startOffset:
     during an offset the drawable shows its static (final) state, which would flash. Both shapes have the
     same structure, which is what lets the system morph one into the other. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:ordering="sequentially">
    <objectAnimator android:duration="250" android:propertyName="pathData" android:valueType="pathType"
        android:valueFrom="M250,250m-1,0a1,1 0 1,0 2,0a1,1 0 1,0 -2,0Z" android:valueTo="M250,250m-1,0a1,1 0 1,0 2,0a1,1 0 1,0 -2,0Z"/>
    <objectAnimator android:duration="384" android:propertyName="pathData" android:valueType="pathType"
        android:valueFrom="M250,250m-1,0a1,1 0 1,0 2,0a1,1 0 1,0 -2,0Z" android:valueTo="M250,250m-300,0a300,300 0 1,0 600,0a300,300 0 1,0 -600,0Z" android:interpolator="@android:interpolator/decelerate_cubic"/>
</set>
