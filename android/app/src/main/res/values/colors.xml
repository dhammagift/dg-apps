<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Owner report (#15): in the AAB the strip behind the status bar was white even with the
         page in dark mode. It is the window background showing through — Android 15 enforces
         edge-to-edge and IGNORES statusBarColor (targetSdk here is 36), so nothing else can paint
         that strip. The colour is the site's own navbar band (#dg-hero-navbar, its 'dg-navy' token), which
         is the same dark strip in both themes, so this is deliberately NOT a themed colour and the
         page theme no longer takes part. -->
    <!-- dg-apps#40: the page now runs edge to edge under transparent system bars, so this colour
         is only what shows before the first paint (and round the page on a WebView too old to pass
         the insets through, where Capacitor still pads it): the page background, not a navy frame.
         values-night/colors.xml has the dark one. -->
    <color name="dg_navbar">#ffffff</color>
</resources>
