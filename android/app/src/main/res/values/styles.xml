<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. DayNight, not fixed Light: the app has a dark mode (the site's own
         theme setting lives in localStorage and is applied by the page), so the native chrome —
         the window behind the WebView before the first paint, dialogs, the system bars — should
         follow the OS instead of forcing everything light. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- Issue #15: the strip behind the status bar is the site's dark navbar band, in both
             themes (see colors.xml). Light icons on it, never the system's light-mode default. -->
        <item name="android:windowBackground">@color/dg_navbar</item>
        <item name="android:statusBarColor">@color/dg_navbar</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Issue #15: the strip behind the status bar is the site's dark navbar band, in both
             themes (see colors.xml). Light icons on it, never the system's light-mode default. -->
        <item name="android:windowBackground">@color/dg_navbar</item>
        <item name="android:statusBarColor">@color/dg_navbar</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- The launch screen, the same as the dictionary's and Uposatha's (owner, 2026-10-04: "the main app
         opens worse than the secondary ones"): the page's own background (dg_splash_bg, light/dark by
         the system theme) and the Dhamma.Gift mark animated on it (drawable/dg_splash_icon.xml, 890 ms like Uposatha's: 250 ms still, then a circle
         opens from the book upwards, the motion of a tap on the logo on dhamma.gift). MainActivity holds
         it until the page has drawn, so it hands over to the page, not to an empty WebView.
         History: this mark was tried on 2026-09-26 (ed1c32d) and reverted to the launcher icon on navy
         (df2dc58); then the splash was released after a fixed 750 ms, before the heavy page had drawn.
         postSplashScreenTheme is what hands over to the real theme; without it the app would keep
         the splash theme and the WebView would never appear. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/dg_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/dg_splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">890</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:background">@color/dg_splash_bg</item>
        <!-- Status bar icons that read on the splash background: dark on light, light on dark. -->
        <item name="android:windowLightStatusBar">@bool/dg_splash_light_bar</item>
    </style>
</resources>