<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The App Shortcuts (long-press menu) are all dynamic, pushed by the page (DgShortcutsPlugin), so each can
                 show the moon of its own day; a shortcut's route arrives as an extra, MainActivity.handleIntent.
                 One fixed launcher activity on purpose: a launcher icon that followed the moon (one activity-alias
                 per phase, switched on and off) made Android drop these shortcuts at every change of phase. -->
        </activity>

        <!-- DgAlarm: the reminders' sound on the alarm stream (DgAlarmPlugin), and re-setting them after a reboot or an update. -->
        <receiver android:name=".DgAlarmReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The home-screen widgets (WidgetProvider): seven separate widgets, drawn from the data DgWidgetPlugin keeps. Not exported: the
             system sends its own broadcasts to them; the taps are PendingIntents of this app. The extra actions re-plan the redraws after a
             reboot, an update of the app, or a change of the clock or the zone (the counter runs on the clock). The reminders'
             receiver above is separate and untouched. -->
        <!-- WidgetProvider is the base of the widgets below: it receives the calendar's month arrows (NAV), the redraw alarm (TICK) and the
             system's boot / update / clock broadcasts; it is not itself in the picker. -->
        <receiver android:name=".WidgetProvider" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".WidgetProviderMoon" android:label="@string/widget_label_moon" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_moon" />
        </receiver>
        <receiver android:name=".WidgetProviderMoonUpo" android:label="@string/widget_label_moonupo" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_moonupo" />
        </receiver>
        <receiver android:name=".WidgetProviderSmall" android:label="@string/widget_label_s" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_s" />
        </receiver>
        <receiver android:name=".WidgetProviderStrip" android:label="@string/widget_label_strip" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_strip" />
        </receiver>
        <receiver android:name=".WidgetProviderMedium" android:label="@string/widget_label_m" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_m" />
        </receiver>
        <receiver android:name=".WidgetProviderDay" android:label="@string/widget_label_day" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_day" />
        </receiver>
        <receiver android:name=".WidgetProviderLarge" android:label="@string/widget_label_l" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_l" />
        </receiver>
        <!-- A tap on a widget: shows nothing, leaves the route for MainActivity and opens the app as its icon does (see the class). -->
        <activity android:name=".WidgetOpenActivity" android:exported="false" android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true" android:taskAffinity="" android:noHistory="true" />
        <!-- The settings of one widget: opened by the launcher (the gear of a widget; on Android 11 and older also when it is added). -->
        <activity android:name=".WidgetConfigActivity" android:exported="true" android:theme="@style/WidgetConfigTheme" android:excludeFromRecents="true" android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- DgSound: the sound the reader picked for the reminders. The file is copied into the app's
             own files/sounds/ and handed to the system UI (which plays a notification channel's
             sound) as a content:// URI of this provider. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Uposatha in the Quick Settings shade (DgTileService). exported="true" is required: the system's
             Quick Settings process binds the service; BIND_QUICK_SETTINGS_TILE is a signature permission, so only the
             system can. The icon is a single-colour drawable (a tile draws it in one colour). -->
        <service
            android:name=".DgTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_uposatha"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- "My place" on the calendar page asks the WebView for the phone's position (navigator.geolocation).
         Capacitor answers the page's prompt with the system permission dialog, but only for permissions
         the manifest declares: without these two the page never got a question and never got a place. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- The reminders are local notifications: Android 13+ asks for this at the first reminder. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- A reminder has to arrive at its minute, with the app closed and the phone dozing. This is
         the permission Android grants a calendar / reminder app without a prompt (API 33+);
         SCHEDULE_EXACT_ALARM would have to be granted by hand in the system settings. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Lets the app appear in the system list "Do Not Disturb access": reminders should sound through
         Do Not Disturb, and only the reader can allow that (DgSoundPlugin.requestDndAccess opens the page). -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Alarms are lost on reboot: the LocalNotifications plugin re-arms them on boot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <queries>
        <!-- Text-selection menu inside our own WebView (dg-apps#48): from Android 11 an app only
             sees other apps' PROCESS_TEXT handlers it declares here, so the selection toolbar in
             Uposatha showed neither DG nor the dictionary, and the dictionary did not show DG. -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
</manifest>
