<?xml version="1.0" encoding="utf-8"?>
<!-- Day bar part (ProgressBar progress drawable, see w_daybar.xml): drawn from the left edge to its end; the gap to the next part is its last 2 dp. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%" android:scaleGravity="left">
            <layer-list>
                <item><shape android:shape="rectangle"><solid android:color="@color/w_accent" /><corners android:topLeftRadius="6dp" android:bottomLeftRadius="6dp" /></shape></item>
                <item android:gravity="right" android:width="2dp"><shape android:shape="rectangle"><solid android:color="@color/w_surface" /></shape></item>
            </layer-list>
        </scale>
    </item>
</layer-list>