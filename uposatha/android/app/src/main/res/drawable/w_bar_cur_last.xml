<?xml version="1.0" encoding="utf-8"?>
<!-- Day bar part (ProgressBar progress drawable, see w_daybar.xml): drawn from the left edge to its end; the last part, rounded on the right. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%" android:scaleGravity="left">
            <layer-list>
                <item><shape android:shape="rectangle"><solid android:color="@color/w_accent" /><corners android:topLeftRadius="6dp" android:bottomLeftRadius="6dp" android:topRightRadius="6dp" android:bottomRightRadius="6dp" /></shape></item>
                
            </layer-list>
        </scale>
    </item>
</layer-list>