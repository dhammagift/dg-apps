<?xml version="1.0" encoding="utf-8"?>
<!-- The "now" mark of the day bar: a 2 dp line at the right edge of the progress (ProgressBar, see w_daybar.xml). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%" android:scaleGravity="left">
            <layer-list>
                <item android:gravity="right" android:width="2dp"><shape android:shape="rectangle"><solid android:color="@color/w_text" /><corners android:radius="1dp" /></shape></item>
            </layer-list>
        </scale>
    </item>
</layer-list>