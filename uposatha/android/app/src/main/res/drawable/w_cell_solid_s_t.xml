<?xml version="1.0" encoding="utf-8"?>
<!-- A month-grid day: generated by shape (r round, sr/sl square on the side that joins the next / previous cell of the strip, s both), _t = with the today ring. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"><item><shape android:shape="rectangle"><solid android:color="@color/w_accent" /><corners android:topLeftRadius="0dp" android:bottomLeftRadius="0dp" android:topRightRadius="0dp" android:bottomRightRadius="0dp" /></shape></item><item android:left="1.5dp" android:top="1.5dp" android:right="1.5dp" android:bottom="1.5dp"><shape android:shape="rectangle"><stroke android:width="1.5dp" android:color="@color/w_text" /><corners android:radius="100dp" /></shape></item></layer-list>