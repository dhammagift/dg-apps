<?xml version="1.0" encoding="utf-8"?>
<!-- The card behind the widget's picture. It is NOT part of the picture: a picture shown at another size than it was drawn for (the
     launcher resizes before the new picture is ready) is only scaled evenly (fitCenter) and the bars at its sides are this same colour. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#FFFFFF" />
    <corners android:radius="22dp" />
</shape>
