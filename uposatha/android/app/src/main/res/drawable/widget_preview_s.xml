<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker's preview (120x120): a card with the moon and the counter's lines, in the widget's own colours. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#ffffff" />
            <corners android:radius="22dp" />
            <size android:width="120dp" android:height="120dp" />
        </shape>
    </item>
    <item android:left="14dp" android:top="14dp" android:width="36dp" android:height="36dp">
        <bitmap android:src="@drawable/moon_nasa" android:gravity="fill" />
    </item>
    <item android:left="14dp" android:top="62dp" android:width="60dp" android:height="8dp">
        <shape android:shape="rectangle"><solid android:color="#0f7c63" /><corners android:radius="4dp" /></shape>
    </item>
    <item android:left="14dp" android:top="78dp" android:width="90dp" android:height="14dp">
        <shape android:shape="rectangle"><solid android:color="#1b1d19" /><corners android:radius="4dp" /></shape>
    </item>
    <item android:left="14dp" android:top="98dp" android:width="70dp" android:height="8dp">
        <shape android:shape="rectangle"><solid android:color="#d7d4c9" /><corners android:radius="4dp" /></shape>
    </item>
</layer-list>
