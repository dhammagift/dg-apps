        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:max="1000"
        android:progress="0"
        android:indeterminate="false"
        android:indeterminateOnly="false"
        android:progressDrawable="@drawable/w_bar_cur"
        android:minHeight="1dp"
