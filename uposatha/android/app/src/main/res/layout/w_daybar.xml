<?xml version="1.0" encoding="utf-8"?>
<!-- The day bar: six parts from dawn to dawn, as stacked ProgressBars (a bar k is drawn from the left edge to the END of part k and is the only thing that has a width: setProgressBar = the part's end as a share of the day, the later parts underneath). A part is the green or navy bar_k, or its barc_k (solid accent) when it is the current one; the 2 dp gap to the next part is the last 2 dp of each bar (w_bar_*). bar_now is the 2 dp "now" mark. All proportional: nothing here has a pixel width. The include sets the height (bar + 6 dp of the mark). -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="16dp">
    <ProgressBar
        android:id="@+id/bar5"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:max="1000"
        android:progress="0"
        android:indeterminate="false"
        android:indeterminateOnly="false"
        android:progressDrawable="@drawable/w_bar_night_last"
        android:minHeight="1dp" />
    <ProgressBar
        android:id="@+id/barc5"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:max="1000"
        android:progress="0"
        android:indeterminate="false"
        android:indeterminateOnly="false"
        android:progressDrawable="@drawable/w_bar_cur_last"
        android:minHeight="1dp"
        android:visibility="gone" />
    <ProgressBar
        android:id="@+id/bar4"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:max="1000"
        android:progress="0"
        android:indeterminate="false"
        android:indeterminateOnly="false"
        android:progressDrawable="@drawable/w_bar_night"
        android:minHeight="1dp" />
    <ProgressBar
        android:id="@+id/barc4"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:max="1000"
        android:progress="0"
        android:indeterminate="false"
        android:indeterminateOnly="false"
        android:progressDrawable="@drawable/w_bar_cur"
        android:minHeight="1dp"
        android:visibility="gone" />
    <ProgressBar
        android:id="@+id/bar3"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:max="1000"
        android:progress="0"
        android:indeterminate="false"
        android:indeterminateOnly="false"
        android:progressDrawable="@drawable/w_bar_night"
        android:minHeight="1dp" />
    <ProgressBar
        android:id="@+id/barc3"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:max="1000"
        android:progress="0"
        android:indeterminate="false"
        android:indeterminateOnly="false"
        android:progressDrawable="@drawable/w_bar_cur"
        android:minHeight="1dp"
        android:visibility="gone" />
    <ProgressBar
        android:id="@+id/bar2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:max="1000"
        android:progress="0"
        android:indeterminate="false"
        android:indeterminateOnly="false"
        android:progressDrawable="@drawable/w_bar_day"
        android:minHeight="1dp" />
    <ProgressBar
        android:id="@+id/barc2"
