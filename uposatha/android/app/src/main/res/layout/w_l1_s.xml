<?xml version="1.0" encoding="utf-8"?>
<!-- Layer 1 (Uposatha + kala), small 2x2. Real views: the launcher reflows them to any size; WidgetViews fills them. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/w_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="14dp"
        android:paddingTop="13dp"
        android:paddingRight="14dp"
        android:paddingBottom="26dp">
        <!-- the moon first, as in the picker: the photo at the left, the label and the date beside it -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <FrameLayout android:layout_width="40dp" android:layout_height="40dp">
                <ImageView
                    android:id="@+id/moon_l"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:alpha="@dimen/w_alpha_light" />
                <ImageView
                    android:id="@+id/moon_d"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:alpha="@dimen/w_alpha_dark" />
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="9dp">
                <TextView
                    android:id="@+id/lbl"
                    style="@style/W_Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11dp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8dp"
                    android:autoSizeMaxTextSize="11dp"
                    android:autoSizeStepGranularity="0.5dp" />
                <TextView
                    android:id="@+id/dt"
                    style="@style/W_T2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12dp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="9dp"
                    android:autoSizeMaxTextSize="12dp"
                    android:autoSizeStepGranularity="0.5dp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/to"
                style="@style/W_S2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12dp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9dp"
                android:autoSizeMaxTextSize="12dp"
                android:autoSizeStepGranularity="0.5dp" />
            <include
                layout="@layout/w_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/sub"
                style="@style/W_T2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12.5dp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9dp"
                android:autoSizeMaxTextSize="12.5dp"
                android:autoSizeStepGranularity="0.5dp"
                android:layout_marginTop="2dp" />
            <include
                layout="@layout/w_kala"
                android:layout_marginTop="7dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
    <include
        layout="@layout/w_dots"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="bottom" />
</FrameLayout>
