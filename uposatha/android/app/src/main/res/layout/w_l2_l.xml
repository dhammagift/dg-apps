<?xml version="1.0" encoding="utf-8"?>
<!-- Layer 2 (Day & night), large 4x4: + the list of the six parts (rows added with addView, they share the height). -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/w_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="18dp"
        android:paddingTop="18dp"
        android:paddingRight="18dp"
        android:paddingBottom="30dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/lbl"
                style="@style/W_Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="12.5dp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="10dp"
                android:autoSizeMaxTextSize="12.5dp"
                android:autoSizeStepGranularity="0.5dp"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/date"
                style="@style/W_SM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13.5dp"
                android:letterSpacing="0.04"
                android:layout_marginLeft="8dp" />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <TextView
                android:id="@+id/name"
                style="@style/W_S"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="28dp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="17dp"
                android:autoSizeMaxTextSize="28dp"
                android:autoSizeStepGranularity="0.5dp" />
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/sub"
                    style="@style/W_T2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="14dp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="10dp"
                    android:autoSizeMaxTextSize="14dp"
                    android:autoSizeStepGranularity="0.5dp"
                    android:layout_weight="1" />
                <TextView
                    android:id="@+id/left"
                    style="@style/W_T2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13dp"
                    android:fontFeatureSettings="tnum"
                    android:layout_marginLeft="8dp" />
            </LinearLayout>
            <include
                layout="@layout/w_kala"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />
        </LinearLayout>
        <include
            layout="@layout/w_daybar"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="10dp" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">
            <TextView
                android:id="@+id/tk0"
                style="@style/W_TM"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="11.5dp"
                android:fontFeatureSettings="tnum"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/tk1"
                style="@style/W_TM"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="11.5dp"
                android:fontFeatureSettings="tnum"
                android:layout_weight="1"
                android:gravity="center_horizontal" />
            <TextView
                android:id="@+id/tk2"
                style="@style/W_TM"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="11.5dp"
                android:fontFeatureSettings="tnum"
                android:layout_weight="1"
                android:gravity="center_horizontal" />
            <TextView
                android:id="@+id/tk3"
                style="@style/W_TM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11.5dp"
                android:fontFeatureSettings="tnum"
                android:gravity="end"
                android:layout_marginLeft="4dp" />
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp" />
    </LinearLayout>
    <include
        layout="@layout/w_dots"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="bottom" />
</FrameLayout>
