<?xml version="1.0" encoding="utf-8"?>
<!-- Layer 2 (Day & night), medium 4x2. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/w_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="16dp"
        android:paddingTop="14dp"
        android:paddingRight="16dp"
        android:paddingBottom="26dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/lbl"
                style="@style/W_Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="11.5dp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9dp"
                android:autoSizeMaxTextSize="11.5dp"
                android:autoSizeStepGranularity="0.5dp"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/date"
                style="@style/W_SM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12dp"
                android:letterSpacing="0.04"
                android:layout_marginLeft="8dp" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/name"
                    style="@style/W_S"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="24dp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="13dp"
                    android:autoSizeMaxTextSize="24dp"
                    android:autoSizeStepGranularity="0.5dp" />
                <TextView
                    android:id="@+id/sub"
                    style="@style/W_T2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13dp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="10dp"
                    android:autoSizeMaxTextSize="13dp"
                    android:autoSizeStepGranularity="0.5dp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp">
                <include
                    layout="@layout/w_kala"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end" />
                <TextView
                    android:id="@+id/left"
                    style="@style/W_T2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12dp"
                    android:fontFeatureSettings="tnum"
                    android:layout_gravity="end"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>
        <include
            layout="@layout/w_daybar"
            android:layout_width="match_parent"
            android:layout_height="16dp" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp">
            <TextView
                android:id="@+id/tk0"
                style="@style/W_TM"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="11.5dp"
                android:fontFeatureSettings="tnum"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/tk1"
                style="@style/W_TM"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="11.5dp"
                android:fontFeatureSettings="tnum"
                android:layout_weight="1"
                android:gravity="center_horizontal" />
            <TextView
                android:id="@+id/tk2"
                style="@style/W_TM"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="11.5dp"
                android:fontFeatureSettings="tnum"
                android:layout_weight="1"
                android:gravity="center_horizontal" />
            <TextView
                android:id="@+id/tk3"
                style="@style/W_TM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11.5dp"
                android:fontFeatureSettings="tnum"
                android:gravity="end"
                android:layout_marginLeft="4dp" />
        </LinearLayout>
    </LinearLayout>
    <include
        layout="@layout/w_dots"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="bottom" />
</FrameLayout>
