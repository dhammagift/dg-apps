<?xml version="1.0" encoding="utf-8"?>
<!-- Layer 2 (Day & night), small 2x2. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/w_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="14dp"
        android:paddingTop="13dp"
        android:paddingRight="14dp"
        android:paddingBottom="26dp">
        <TextView
            android:id="@+id/lbl"
            style="@style/W_Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11.5dp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="9dp"
            android:autoSizeMaxTextSize="11.5dp"
            android:autoSizeStepGranularity="0.5dp" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/name"
                style="@style/W_S"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18dp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="12dp"
                android:autoSizeMaxTextSize="18dp"
                android:autoSizeStepGranularity="0.5dp" />
            <TextView
                android:id="@+id/sub"
                style="@style/W_T2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13dp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="10dp"
                android:autoSizeMaxTextSize="13dp"
                android:autoSizeStepGranularity="0.5dp"
                android:layout_marginTop="3dp" />
            <include
                layout="@layout/w_kala"
                android:layout_marginTop="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <include
                layout="@layout/w_daybar"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:layout_marginTop="8dp" />
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp">
                <TextView
                    android:id="@+id/tk0"
                    style="@style/W_TM"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="11.5dp"
                    android:fontFeatureSettings="tnum"
                    android:layout_weight="1" />
                <TextView
                    android:id="@+id/tk1"
                    style="@style/W_TM"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="11.5dp"
                    android:fontFeatureSettings="tnum"
                    android:layout_weight="1"
                    android:gravity="end" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <include
        layout="@layout/w_dots"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="bottom" />
</FrameLayout>
