<?xml version="1.0" encoding="utf-8"?>
<!-- A week of the month grid: seven cells, each a tap target (c0..c6) with the number in regular (t) or semibold (b) letters; the day's look is its background drawable (w_cell_*) and text colour, set by WidgetViews. The pill is at most 20dp tall and centred in a row that may be taller. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="26dp">
    <FrameLayout
        android:id="@+id/c0"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <TextView
            android:id="@+id/t0"
            style="@style/W_T"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:textSize="12dp"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:maxHeight="20dp"
            android:layout_marginVertical="1dp" />
        <TextView
            android:id="@+id/b0"
            style="@style/W_S"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:textSize="12dp"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:maxHeight="20dp"
            android:layout_marginVertical="1dp"
            android:visibility="gone" />
    </FrameLayout>
    <FrameLayout
        android:id="@+id/c1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
