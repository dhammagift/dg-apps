<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The launch screen is only the page's own background, the same one the web splash
         (launch-screens.js) paints: light #ffffff, dark #111111 by the system theme. The mark itself
         is drawn by the web splash, once — the native splash used to show the launcher icon first, and
         the reader got two different logos one after the other. -->
    <color name="dg_splash_bg">#FFFFFF</color>
    <!-- Dark icons in the status bar over the light splash and the light page; the page's own
         SystemBars.setStyle takes over once it has painted (values-night has the dark-appearance
         value, so a dark device gets light icons from the very first frame). -->
    <bool name="dg_light_bar">true</bool>
</resources>
