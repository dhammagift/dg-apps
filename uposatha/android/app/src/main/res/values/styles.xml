<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. DayNight, not fixed Light: the site has its own night
         theme (stored in localStorage and applied by the page), so the native chrome — the window
         behind the WebView before the first paint, dialogs, the system bars — should follow the OS
         instead of forcing everything light. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- Edge to edge (dg-apps#41): the page paints under the transparent bars, so there is no
             strip to colour — this window background is only what shows before its first paint and
             on a WebView too old to pass the insets through. It is the page's own background
             (@color/dg_navbar: white by day, #111111 at night), not a navy frame. Android 15
             ignores android:statusBarColor (targetSdk 36), kept here for the older ones.
             The bar ICONS are the page's (SystemBars.setStyle, uposatha-bridge.js, sent on every
             theme change); the value below is only what the first frame gets — dark icons on the
             light theme, light on the dark one (@bool/dg_light_bar), never a fixed choice. -->
        <item name="android:windowBackground">@color/dg_navbar</item>
        <item name="android:statusBarColor">@color/dg_navbar</item>
        <item name="android:windowLightStatusBar">@bool/dg_light_bar</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/dg_navbar</item>
        <item name="android:statusBarColor">@color/dg_navbar</item>
        <item name="android:windowLightStatusBar">@bool/dg_light_bar</item>
    </style>

    <!-- The launch screen. On the TWA this was a Chrome splash; here it is the launcher icon's own
         plate with the mark centred, so a dark-mode device gets no white flash before the (dark)
         page appears. postSplashScreenTheme is what hands over to the real theme; without it the
         app would keep the splash theme and the WebView would never appear. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/dg_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/dg_splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">890</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:background">@color/dg_splash_bg</item>
        <!-- The splash shows the page's background and the page's icon choice from the first frame
             (@bool/dg_light_bar); the page itself takes over once it has painted. -->
        <item name="android:windowLightStatusBar">@bool/dg_light_bar</item>
    </style>
</resources>
