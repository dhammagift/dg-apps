<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's colours (WidgetRenderer.Theme of the bitmap version, the designer tokens (dg-*)). Dark values: values-night/widget_colors.xml.
     RemoteViews are inflated in the launcher with the app's resources, so the launcher's light/dark switch re-resolves all of them by itself. -->
<resources>
    <color name="w_surface">#FFFFFF</color>
    <color name="w_text">#1B1D19</color>
    <color name="w_text2">#5C6058</color>
    <color name="w_muted">#6E716A</color>
    <color name="w_accent">#149C7C</color>
    <color name="w_accent_ink">#0F7C63</color>
    <color name="w_border">#E7E5DE</color>
    <color name="w_border_strong">#D7D4C9</color>
    <color name="w_navy_ink">#2F4A63</color>
    <color name="w_vik">#9B1C31</color>
    <color name="w_on_accent">#FFFFFF</color>
    <!-- the surface with an amount of a colour mixed in (designer: day parts accent 28 %, night parts navy 30 %, plate navy 22 %, the Uposatha day accent 30 %) -->
    <color name="w_part_day">#BDE3DA</color>
    <color name="w_part_night">#C1C9D0</color>
    <color name="w_plate">#D1D7DD</color>
    <color name="w_band">#B8E1D8</color>
    <!-- the moon pair: the light picture shows on a light card, the one with the halo on a dark card (alpha, because a layout cannot switch visibility by theme) -->
    <item name="w_alpha_light" format="float" type="dimen">1</item>
    <item name="w_alpha_dark" format="float" type="dimen">0</item>
</resources>
