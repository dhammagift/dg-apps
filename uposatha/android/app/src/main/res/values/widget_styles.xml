<?xml version="1.0" encoding="utf-8"?>
<!-- Text styles of the widget's layouts. One line, cut with an ellipsis; Lato (res/font) in the weight of the design: 400 text, 600 semibold, 700 bold.
     Colours are resources with night variants, so the launcher's light/dark switch recolours the text without a redraw. -->
<resources>
    <style name="W_T">
        <item name="android:fontFamily">@font/lato_regular</item>
        <item name="android:textColor">@color/w_text</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="W_T2" parent="W_T"><item name="android:textColor">@color/w_text2</item></style>
    <style name="W_TM" parent="W_T"><item name="android:textColor">@color/w_muted</item></style>
    <style name="W_S" parent="W_T"><item name="android:fontFamily">@font/lato_semibold</item></style>
    <style name="W_S2" parent="W_S"><item name="android:textColor">@color/w_text2</item></style>
    <style name="W_SM" parent="W_S"><item name="android:textColor">@color/w_muted</item></style>
    <style name="W_B" parent="W_T"><item name="android:fontFamily">@font/lato_bold</item></style>
    <!-- the caps label in accent -->
    <style name="W_Label" parent="W_S">
        <item name="android:textColor">@color/w_accent_ink</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

</resources>
