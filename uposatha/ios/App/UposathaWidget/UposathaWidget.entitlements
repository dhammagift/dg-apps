<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The same group as the app (App.entitlements): the app writes the widget's data there (DgWidget.put). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.gift.dhamma.uposatha</string>
	</array>
</dict>
</plist>
